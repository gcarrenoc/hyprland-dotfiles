#!/usr/bin/env python3
"""claude-desktop-update — update Claude Desktop from Anthropic's official repository.

  claude-desktop-update           verify, build and install the newest version (asks for your password)
  claude-desktop-update --check   only say whether a newer version exists

Anthropic publishes Claude Desktop for Linux (beta) as a .deb in its apt repository.
Every step is verified before anything is built:
  1. the saved key ~/.local/src/claude-desktop/anthropic-claude-desktop-key.asc has the
     pinned fingerprint (the one on support.claude.com)
  2. the repository index (InRelease) is signed by that key — checksums are read only
     from the verified text
  3. the package list matches the signed SHA-256
  4. the .deb matches the package list's SHA-256
Then the recipe in ~/.local/src/claude-desktop/PKGBUILD is updated to the new version,
built with makepkg and installed with pacman. Uses temporary keyrings: your GPG keyring
is never touched.
"""
import hashlib, re, shutil, subprocess, sys, tempfile, urllib.request
from pathlib import Path

REPO = "https://downloads.claude.ai/claude-desktop/apt/stable"
FINGERPRINT = "31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"     # Anthropic Claude Code Release Signing
SRC = Path.home() / ".local/src/claude-desktop"
KEY = SRC / "anthropic-claude-desktop-key.asc"
RECIPE = SRC / "PKGBUILD"
ARCH = "amd64"


def say(msg):
    print(f"→ {msg}", flush=True)


def fail(msg):
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(1)


def fetch(url, dest=None):
    req = urllib.request.Request(url, headers={"User-Agent": "claude-desktop-update"})
    with urllib.request.urlopen(req, timeout=60) as r:
        if dest is None:
            return r.read()
        with open(dest, "wb") as f:
            shutil.copyfileobj(r, f)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def newer(a, b):            # pacman's version comparison: is a newer than b?
    return subprocess.run(["vercmp", a, b], capture_output=True, text=True).stdout.strip() == "1"


def main():
    check_only = "--check" in sys.argv
    if not KEY.exists() or not RECIPE.exists():
        fail(f"missing {KEY} or {RECIPE}")
    work = Path(tempfile.mkdtemp(prefix="claude-desktop-update-"))
    try:
        gnupg = work / "gnupg"; gnupg.mkdir(mode=0o700)

        # 1. key fingerprint
        out = subprocess.run(["gpg", "--homedir", str(gnupg), "--show-keys", "--with-colons", str(KEY)],
                             capture_output=True, text=True).stdout
        fprs = re.findall(r"^fpr:+([0-9A-F]{40}):", out, re.M)
        if FINGERPRINT not in fprs:
            fail(f"saved key does not have the pinned fingerprint {FINGERPRINT}")
        keyring = work / "key.gpg"
        keyring.write_bytes(subprocess.run(["gpg", "--homedir", str(gnupg), "--dearmor"],
                                           input=KEY.read_bytes(), capture_output=True).stdout)
        say("Anthropic's key: fingerprint OK")

        # 2. signed index
        fetch(f"{REPO}/dists/stable/InRelease", work / "InRelease")
        verified = work / "Release.verified"
        r = subprocess.run(["gpgv", "--keyring", str(keyring), "--output", str(verified), str(work / "InRelease")],
                           capture_output=True, text=True)
        if r.returncode != 0 or "Good signature" not in r.stderr:
            fail("repository index signature is NOT valid:\n" + r.stderr)
        say("repository index: good signature")
        text = verified.read_text()
        m = re.search(rf"^ ([0-9a-f]{{64}}) +\d+ main/binary-{ARCH}/Packages$", text, re.M)
        if not m:
            fail("no checksum for the package list in the signed index")

        # 3. package list
        fetch(f"{REPO}/dists/stable/main/binary-{ARCH}/Packages", work / "Packages")
        if sha256(work / "Packages") != m.group(1):
            fail("package list does not match the signed checksum")
        say("package list: checksum OK")
        entries = [dict(re.findall(r"^([A-Za-z0-9-]+): (.*)$", b, re.M))
                   for b in (work / "Packages").read_text().strip().split("\n\n")]
        entries = [e for e in entries if e.get("Package") == "claude-desktop" and e.get("Architecture") == ARCH]
        if not entries:
            fail("no claude-desktop package in the repository")
        best = entries[0]
        for e in entries[1:]:
            if newer(e["Version"], best["Version"]):
                best = e
        version = best["Version"]

        q = subprocess.run(["pacman", "-Q", "claude-desktop"], capture_output=True, text=True).stdout.split()
        installed = q[1].rsplit("-", 1)[0] if len(q) == 2 else None
        if installed and not newer(version, installed):
            say(f"up to date: {installed}")
            return
        say(f"new version: {version}" + (f" (installed: {installed})" if installed else ""))
        if check_only:
            return

        # 4. the .deb
        deb = work / f"claude-desktop_{version}_{ARCH}.deb"
        say(f"downloading {best['Filename'].rsplit('/', 1)[-1]} ({int(best['Size']) // 1_000_000} MB)…")
        fetch(f"{REPO}/{best['Filename']}", deb)
        if sha256(deb) != best["SHA256"]:
            fail(".deb does not match the package list's checksum")
        say(".deb: checksum OK")

        # build with the saved recipe, updated to this version
        recipe = RECIPE.read_text()
        recipe = re.sub(r"^pkgver=.*$", f"pkgver={version}", recipe, flags=re.M)
        recipe = re.sub(r"^pkgrel=.*$", "pkgrel=1", recipe, flags=re.M)
        recipe = re.sub(r"^sha256sums=\('[0-9a-f]+'\)$", f"sha256sums=('{best['SHA256']}')", recipe, flags=re.M)
        build = work / "build"; build.mkdir()
        (build / "PKGBUILD").write_text(recipe)
        deb.rename(build / deb.name)
        say("building the package…")
        if subprocess.run(["makepkg", "-f", "--noconfirm"], cwd=build).returncode != 0:
            fail("makepkg failed")
        pkg = next(build.glob("claude-desktop-*.pkg.tar.zst"))
        say("installing (asks for your password)…")
        if subprocess.run(["pkexec", "pacman", "-U", "--noconfirm", str(pkg)]).returncode != 0:
            fail("pacman did not install the package")
        RECIPE.write_text(recipe)
        say(f"Claude Desktop {version} installed — restart the app to use it")
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
