#!/usr/bin/env python3
"""claude-desktop-update — keep Claude Desktop up to date in the background (no password, silent).

  claude-desktop-update           download + verify the newest version and get it ready
  claude-desktop-update --check   only say whether a newer version exists

From Anthropic's signed apt repository into ~/.local/opt/claude-desktop (launcher:
~/.local/bin/claude-desktop). Runs daily and after login (claude-desktop-update.timer). How it
works and what it verifies: ~/.local/lib/apt_app.py. The key's fingerprint is the one on
support.claude.com.
"""
import re, shutil, subprocess, sys
from pathlib import Path

sys.dont_write_bytecode = True
HOME = Path.home()
sys.path.insert(0, str(HOME / ".local/lib"))
from apt_app import AptApp


def integrate(app, root):
    """Launcher entry, icons and file types in your home folder (no root)."""
    share = HOME / ".local/share"
    entry = (root / "usr/share/applications/com.anthropic.Claude.desktop").read_text()
    entry = re.sub(r"^Exec=claude-desktop", f"Exec={HOME / '.local/bin/claude-desktop'}", entry, flags=re.M)
    (share / "applications").mkdir(parents=True, exist_ok=True)
    (share / "applications/com.anthropic.Claude.desktop").write_text(entry)
    for png in (root / "usr/share/icons").rglob("*.png"):
        dest = share / "icons" / png.relative_to(root / "usr/share/icons")
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(png, dest)
    mime = share / "mime/packages"
    mime.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(app / "resources/linux-mime/com.anthropic.Claude.xml", mime / "com.anthropic.Claude.xml")
    for cmd in (["update-mime-database", str(share / "mime")], ["update-desktop-database", str(share / "applications")],
                ["gtk-update-icon-cache", "-q", "-t", "-f", str(share / "icons/hicolor")]):
        subprocess.run(cmd, capture_output=True)


sys.exit(AptApp(
    title="Claude Desktop", package="claude-desktop", repo="https://downloads.claude.ai/claude-desktop/apt/stable",
    fingerprint="31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE",          # Anthropic Claude Code Release Signing
    key=HOME / ".local/src/claude-desktop/anthropic-claude-desktop-key.asc",
    opt=HOME / ".local/opt/claude-desktop", binary="claude-desktop", lib="usr/lib/claude-desktop",
    integrate=integrate).main())
