#!/usr/bin/env python3
"""claude-desktop-update — keep Claude Desktop up to date, Discord-style (no password).

  claude-desktop-update           download + verify the newest version and get it ready
  claude-desktop-update --check   only say whether a newer version exists

Claude Desktop lives in your home folder: ~/.local/opt/claude-desktop/<version>/,
with `current` pointing at the one in use. A new version is unpacked next to it and
used from the next start (`claude-desktop` launcher), or at once if Claude isn't open.
Runs daily and 5 min after login (claude-desktop-update.timer).

Every download is verified before it's used (Anthropic publishes Linux as a .deb):
  1. the saved key ~/.local/src/claude-desktop/anthropic-claude-desktop-key.asc has the
     pinned fingerprint (the one on support.claude.com)
  2. the repository index (InRelease) is signed by that key — checksums are read only
     from the verified text
  3. the package list matches the signed SHA-256
  4. the .deb matches the package list's SHA-256
Temporary keyrings only: your GPG keyring is never touched.
"""
import hashlib, json, os, re, shutil, subprocess, sys, tempfile, urllib.error, urllib.request
from pathlib import Path

REPO = "https://downloads.claude.ai/claude-desktop/apt/stable"
FINGERPRINT = "31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"     # Anthropic Claude Code Release Signing
KEY = Path.home() / ".local/src/claude-desktop/anthropic-claude-desktop-key.asc"
OPT = Path.home() / ".local/opt/claude-desktop"
ARCH = "amd64"
KEEP = 2                                                   # versions kept on disk (current + previous)


def say(msg):
    print(f"→ {msg}", flush=True)


def fail(msg):
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(1)


def fetch(url, dest=None):
    req = urllib.request.Request(url, headers={"User-Agent": "claude-desktop-update"})
    with urllib.request.urlopen(req, timeout=60) as r:
        if dest is None:
            return r.read()
        with open(dest, "wb") as f:
            shutil.copyfileobj(r, f)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def newer(a, b):            # pacman's version comparison: is a newer than b?
    return subprocess.run(["vercmp", a, b], capture_output=True, text=True).stdout.strip() == "1"


def installed():
    try:
        return (OPT / "current" / "VERSION").read_text().strip()
    except OSError:
        return None


def running():
    return subprocess.run(["pgrep", "-f", f"^{OPT}/[^ ]*/claude-desktop( |$)"], capture_output=True).returncode == 0


def switch_if_idle():
    """Use the newest unpacked version now, unless Claude is open (then: at its next start)."""
    nxt = OPT / "next"
    if not nxt.is_symlink() or running():
        return False
    target = os.readlink(nxt)
    tmp = OPT / "current.new"
    tmp.unlink(missing_ok=True)
    tmp.symlink_to(target)
    tmp.replace(OPT / "current")
    nxt.unlink()
    versions = sorted((p for p in OPT.iterdir() if p.is_dir() and not p.is_symlink()),
                      key=lambda p: p.stat().st_mtime, reverse=True)
    for old in versions[KEEP:]:
        shutil.rmtree(old, ignore_errors=True)
    return True


def integrate(app):
    """Launcher entry, icons and file types in your home folder (no root)."""
    share = Path.home() / ".local/share"
    root = app / "_deb"
    desk = root / "usr/share/applications/com.anthropic.Claude.desktop"
    text = desk.read_text()
    launcher = Path.home() / ".local/bin/claude-desktop"
    text = re.sub(r"^Exec=claude-desktop", f"Exec={launcher}", text, flags=re.M)
    (share / "applications").mkdir(parents=True, exist_ok=True)
    (share / "applications/com.anthropic.Claude.desktop").write_text(text)
    for png in (root / "usr/share/icons").rglob("*.png"):
        dest = share / "icons" / png.relative_to(root / "usr/share/icons")
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(png, dest)
    mime = share / "mime/packages"
    mime.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(app / "resources/linux-mime/com.anthropic.Claude.xml", mime / "com.anthropic.Claude.xml")
    for cmd in (["update-mime-database", str(share / "mime")], ["update-desktop-database", str(share / "applications")],
                ["gtk-update-icon-cache", "-q", "-t", "-f", str(share / "icons/hicolor")]):
        subprocess.run(cmd, capture_output=True)
    shutil.rmtree(root, ignore_errors=True)


def main():
    check_only = "--check" in sys.argv
    OPT.mkdir(parents=True, exist_ok=True)
    if not check_only and switch_if_idle():
        say(f"now using {installed()} (unpacked earlier)")
    if not KEY.exists():
        fail(f"missing {KEY}")
    work = Path(tempfile.mkdtemp(prefix="claude-desktop-update-"))
    try:
        gnupg = work / "gnupg"; gnupg.mkdir(mode=0o700)

        # 1. key fingerprint
        out = subprocess.run(["gpg", "--homedir", str(gnupg), "--show-keys", "--with-colons", str(KEY)],
                             capture_output=True, text=True).stdout
        if FINGERPRINT not in re.findall(r"^fpr:+([0-9A-F]{40}):", out, re.M):
            fail(f"saved key does not have the pinned fingerprint {FINGERPRINT}")
        keyring = work / "key.gpg"
        keyring.write_bytes(subprocess.run(["gpg", "--homedir", str(gnupg), "--dearmor"],
                                           input=KEY.read_bytes(), capture_output=True).stdout)

        # 2. signed index
        fetch(f"{REPO}/dists/stable/InRelease", work / "InRelease")
        verified = work / "Release.verified"
        r = subprocess.run(["gpgv", "--keyring", str(keyring), "--output", str(verified), str(work / "InRelease")],
                           capture_output=True, text=True)
        if r.returncode != 0 or "Good signature" not in r.stderr:
            fail("repository index signature is NOT valid:\n" + r.stderr)
        m = re.search(rf"^ ([0-9a-f]{{64}}) +\d+ main/binary-{ARCH}/Packages$", verified.read_text(), re.M)
        if not m:
            fail("no checksum for the package list in the signed index")

        # 3. package list
        fetch(f"{REPO}/dists/stable/main/binary-{ARCH}/Packages", work / "Packages")
        if sha256(work / "Packages") != m.group(1):
            fail("package list does not match the signed checksum")
        say("signature and checksums OK")
        entries = [dict(re.findall(r"^([A-Za-z0-9-]+): (.*)$", b, re.M))
                   for b in (work / "Packages").read_text().strip().split("\n\n")]
        entries = [e for e in entries if e.get("Package") == "claude-desktop" and e.get("Architecture") == ARCH]
        if not entries:
            fail("no claude-desktop package in the repository")
        best = entries[0]
        for e in entries[1:]:
            if newer(e["Version"], best["Version"]):
                best = e
        version = best["Version"]

        have = installed()
        pending = os.readlink(OPT / "next").split("/")[-1] if (OPT / "next").is_symlink() else None
        if (have and not newer(version, have)) or pending == version:
            say(f"up to date: {have}" + (f" ({pending} ready for the next start)" if pending else ""))
            return
        say(f"new version: {version}" + (f" (in use: {have})" if have else ""))
        if check_only:
            return

        # 4. the .deb
        deb = work / "claude-desktop.deb"
        fetch(f"{REPO}/{best['Filename']}", deb)
        if sha256(deb) != best["SHA256"]:
            fail(".deb does not match the package list's checksum")
        say(".deb checksum OK — unpacking")

        # unpack next to the current version: <OPT>/<version>/ (= /usr/lib/claude-desktop of the .deb)
        stage = work / "deb"; stage.mkdir()
        subprocess.run(["bsdtar", "-xf", str(deb), "-C", str(stage)], check=True)
        root = stage / "root"; root.mkdir()
        data = next(stage.glob("data.tar.*"))
        subprocess.run(["bsdtar", "-xf", str(data), "-C", str(root)], check=True)
        dest = OPT / version
        shutil.rmtree(dest, ignore_errors=True)
        shutil.move(str(root / "usr/lib/claude-desktop"), dest)
        shutil.move(str(root), dest / "_deb")                     # desktop entry, icons (for integrate)
        (dest / "chrome-sandbox").chmod(0o755)                   # no setuid: Arch's user-namespace sandbox works
        (dest / "VERSION").write_text(version + "\n")
        integrate(dest)

        nxt = OPT / "next"
        nxt.unlink(missing_ok=True)
        nxt.symlink_to(version)
        if switch_if_idle():
            say(f"Claude Desktop {version} installed and in use")
            subprocess.run(["notify-send", "-a", "Claude Desktop", "-u", "low", "-i", "claude-desktop",
                            f"Claude Desktop updated to {version}"], capture_output=True)
        else:
            say(f"Claude Desktop {version} ready — used from its next start")
            subprocess.run(["notify-send", "-a", "Claude Desktop", "-u", "low", "-i", "claude-desktop",
                            f"Claude Desktop {version} is ready", "It's used the next time you open Claude."],
                           capture_output=True)
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, urllib.error.URLError, subprocess.CalledProcessError) as e:   # offline, server down…
        fail(f"could not update: {e}")
