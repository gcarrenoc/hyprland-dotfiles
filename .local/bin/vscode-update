#!/usr/bin/env python3
"""vscode-update — keep Visual Studio Code up to date in the background (no password, silent).

  vscode-update           download + verify the newest version and get it ready
  vscode-update --check   only say whether a newer version exists

From Microsoft's signed apt repository into ~/.local/opt/vscode (launcher: ~/.local/bin/code).
Runs daily and after login (vscode-update.timer). How it works and what it verifies:
~/.local/lib/apt_app.py. The key's fingerprint is the one on learn.microsoft.com/linux/packages.
"""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HOME = Path.home()
sys.path.insert(0, str(HOME / ".local/lib"))
from apt_app import AptApp

sys.exit(AptApp(
    title="VS Code", package="code", repo="https://packages.microsoft.com/repos/code",
    fingerprint="BC528686B50D79E339D3721CEB3E94ADBE1229CF",          # Microsoft (Release signing)
    key=HOME / ".local/src/vscode/microsoft.asc",
    opt=HOME / ".local/opt/vscode", binary="code", lib="usr/share/code").main())
