#!/usr/bin/env python3
"""jupyter-app — JupyterLab as a desktop app (background server + app window + bar icon).

  jupyter-app open [lab|notebook]   start the server if needed, open it in its own window
  jupyter-app stop                  stop the server (running notebooks are shut down cleanly)
  jupyter-app waybar                JSON for the bar icon (empty = hidden while stopped)

The server is the systemd user service jupyterlab.service (~/.config/systemd/user):
this computer only (127.0.0.1), folder = your home, idle notebooks shut down after 1 h,
the server itself after 2 h without activity. Logs: journalctl --user -u jupyterlab
"""
import json, os, subprocess, sys, time, urllib.request
from pathlib import Path

SERVICE = "jupyterlab.service"
RUNTIME = Path.home() / ".local/share/jupyter/runtime"
ICON = "<span font_family='lucide'>\ue3e7</span>"          # lucide "orbit"
PAGES = {"lab": "lab", "notebook": "tree"}


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def active():
    return run("systemctl", "--user", "is-active", SERVICE).stdout.strip() == "active"


def main_pid():
    out = run("systemctl", "--user", "show", "-p", "MainPID", "--value", SERVICE).stdout.strip()
    return int(out) if out.isdigit() and out != "0" else None


def server():
    """The running server's info (url, token, root_dir) from Jupyter's runtime file."""
    pid = main_pid()
    if not pid:
        return None
    f = RUNTIME / f"jpserver-{pid}.json"
    try:
        return json.loads(f.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def notify(title, body="", urgency="low"):
    subprocess.run(["notify-send", "-a", "JupyterLab", "-u", urgency, "-i", "org.jupyter.JupyterLab", title, body])


def open_app(page):
    if not active():
        notify("Starting JupyterLab…")
        if run("systemctl", "--user", "start", SERVICE).returncode != 0:
            notify("JupyterLab didn't start", "journalctl --user -u jupyterlab", "normal")
            return
    info = None
    for _ in range(100):                                   # wait up to 20 s for the server
        info = server()
        if info:
            try:
                urllib.request.urlopen(f"{info['url']}api/status?token={info['token']}", timeout=1)
                break
            except OSError:
                pass
        time.sleep(0.2)
    else:
        notify("JupyterLab didn't answer", "journalctl --user -u jupyterlab", "normal")
        return
    url = f"{info['url']}{PAGES.get(page, 'lab')}?token={info['token']}"
    browser = ["google-chrome-stable", f"--app={url}"]    # its own window: no tabs or address bar
    if subprocess.run(["which", "google-chrome-stable"], capture_output=True).returncode != 0:
        browser = ["xdg-open", url]
    subprocess.Popen(["uwsm", "app", "--", *browser], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def jupyter_windows():
    try:
        clients = json.loads(run("hyprctl", "clients", "-j").stdout)
    except json.JSONDecodeError:
        return []
    return [c["address"] for c in clients if c.get("class", "").startswith("chrome-127.0.0.1__")]


def stop():
    if not active():
        return
    for address in jupyter_windows():                      # its windows are useless without the server
        run("hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{address}" }})')
    run("systemctl", "--user", "stop", SERVICE)
    notify("JupyterLab stopped", "Its notebooks were shut down; your files are saved.")


def descendants(pid):
    kids, todo = [], [pid]
    while todo:
        p = todo.pop()
        try:
            for c in Path(f"/proc/{p}/task/{p}/children").read_text().split():
                kids.append(int(c)); todo.append(int(c))
        except OSError:
            pass
    return kids


def rss_mb(pid):
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1]) / 1024
    except OSError:
        pass
    return 0


def waybar():
    if not active():
        print(json.dumps({"text": "", "class": "stopped"}))
        return
    info = server()
    pid = main_pid()
    kernels = []
    if info:
        try:
            with urllib.request.urlopen(f"{info['url']}api/kernels?token={info['token']}", timeout=1) as r:
                kernels = json.load(r)
        except OSError:
            pass
    mem = rss_mb(pid) + sum(rss_mb(k) for k in descendants(pid)) if pid else 0
    since = run("systemctl", "--user", "show", "-p", "ActiveEnterTimestampMonotonic", "--value", SERVICE).stdout.strip()
    up = ""
    if since.isdigit() and int(since):
        secs = time.clock_gettime(time.CLOCK_MONOTONIC) - int(since) / 1e6
        up = f"{int(secs // 3600)} h {int(secs % 3600 // 60)} min" if secs >= 3600 else f"{int(secs // 60)} min"
    busy = sum(1 for k in kernels if k.get("execution_state") == "busy")
    root = str(info.get("root_dir", "~")).replace(str(Path.home()), "~") if info else "~"
    lines = [f"JupyterLab — running {up}".rstrip(),
             f"{len(kernels)} notebook{'s' if len(kernels) != 1 else ''} running" + (f" ({busy} busy)" if busy else ""),
             f"Memory: {mem / 1024:.1f} GB" if mem >= 1024 else f"Memory: {mem:.0f} MB",
             f"Folder: {root}",
             f"{info['url']}" if info else "starting…",
             "", "Click: open · Right-click: stop"]
    print(json.dumps({"text": ICON, "class": "busy" if busy else "running", "tooltip": "\n".join(lines)}))


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "open":
        open_app(sys.argv[2] if len(sys.argv) > 2 else "lab")
    elif cmd == "stop":
        stop()
    elif cmd == "waybar":
        waybar()
    else:
        sys.exit(__doc__)
