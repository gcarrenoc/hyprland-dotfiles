/* Power menu — Balcony */
@import "balcony.rasi"

configuration { show-icons: false; }

window   { width: 79.38mm; }
mainbox  { children: [ "message", "listview" ]; padding: 5.82mm; }
message  { background-color: transparent; padding: 0 1.06mm 1.59mm 1.06mm; }
textbox  { text-color: @selected; horizontal-align: 0.5; }
listview { lines: 5; }
element  { padding: 2.65mm 3.70mm; }
element-text { horizontal-align: 0; }
