/* Colours: colors.rasi (generated from the wallpaper by ~/.config/hypr/scripts/theme) */
@import "colors.rasi"

* {
    font:             "PaperMono Nerd Font 11";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            116.42mm;
    border:           0;          /* corners + border drawn by Hyprland (squircle) */
    border-radius:    0;
    background-color: @background;
}

mainbox {
    spacing:  2.65mm;
    padding:  6.88mm;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:          2.65mm;
    padding:          2.65mm 3.70mm;
    border-radius:    3.17mm;
    background-color: @background-alt;
    children:         [ "prompt", "entry" ];
}
prompt { text-color: @selected; }
entry {
    placeholder:       "Search…";
    placeholder-color: @muted;
    cursor:            text;
}

message { padding: 1.59mm 3.17mm; border: 0; border-radius: 2.65mm; background-color: transparent; }
textbox { text-color: @foreground; }

listview {
    border:       0;
    columns:      1;
    lines:        8;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    fixed-height: true;
    spacing:      1.32mm;
}

element {
    spacing:       2.65mm;
    padding:       1.85mm 2.65mm;
    border-radius: 2.65mm;
    cursor:        pointer;
}
element normal.normal     { background-color: transparent; text-color: @foreground; }
element alternate.normal  { background-color: transparent; text-color: @foreground; }
element normal.urgent     { text-color: @urgent; }
element normal.active     { text-color: @selected; }
element selected.normal   { background-color: @selected; text-color: @on-selected; }
element selected.urgent   { background-color: @urgent;   text-color: @on-selected; }
element selected.active   { background-color: @active;   text-color: @foreground; }
element-icon { size: 6.35mm; cursor: inherit; }
element-text { vertical-align: 0.5; cursor: inherit; text-color: inherit; }

mode-switcher { spacing: 2.65mm; }
button {
    padding:          2.12mm;
    border-radius:    2.65mm;
    background-color: @background-alt;
    text-color:       @foreground;
    cursor:           pointer;
}
button selected { background-color: @selected; text-color: @on-selected; }
