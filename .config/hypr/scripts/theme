#!/usr/bin/env python3
"""Theme from the wallpaper — everything follows the wallpaper's colours.

  theme            sync with the wallpaper setting; regenerate if it changed
  theme --force    regenerate even if the wallpaper is the same
  theme --show     show the colours in use (terminal swatches), change nothing
  (set a new wallpaper with:  wallpaper <image>)

1. Uses the wallpaper in gsettings (org.gnome.desktop.background picture-uri,
   also read by portals) and points ~/.config/hypr/wallpapers/current.jpg at it.
2. Reads the photo in OKLab (a perceptual colour space) and groups it into 24 colours (k-means).
   Tint = the photo's average colour direction; a nearly grey photo gives a nearly grey desktop.
   Accent = the most striking colour it really has (vivid, enough of it, standing out from the tint,
   like Material You's scoring); none → the tint's opposite. Colours are built in OKLCH, so every
   hue looks equally light, and text is pushed until it meets WCAG contrast (7:1 text, 4.5:1 hints).
3. Writes colour files for: terminal (alacritty/wallpaper-colors.toml,
   tmux/wallpaper.conf), bar (waybar/colors.css), window borders
   (hypr/colors.lua), launcher & menus (rofi/colors.rasi), notifications
   (swaync/colors.css), lock screen (hypr/hyprlock-colors.conf),
   password dialog (hypr/hyprtoolkit.conf), PDF viewer (zathura/colors).
4. Reloads whatever is running. Dark bar, light menus (tinted), as designed.
"""
import colorsys, hashlib, math, os, re, subprocess, sys
from pathlib import Path
from urllib.parse import unquote, urlparse

HOME = Path.home()
LINK = HOME / ".config/hypr/wallpapers/current.jpg"
ALACRITTY = HOME / ".config/alacritty/wallpaper-colors.toml"
TMUX = HOME / ".config/tmux/wallpaper.conf"
CACHE = HOME / ".cache/theme.key"
OUT = {
    "waybar": HOME / ".config/waybar/colors.css",
    "hypr": HOME / ".config/hypr/colors.lua",
    "rofi": HOME / ".config/rofi/colors.rasi",
    "swaync": HOME / ".config/swaync/colors.css",          # notifications + Notification Center
    "lock": HOME / ".config/hypr/hyprlock-colors.conf",
    "toolkit": HOME / ".config/hypr/hyprtoolkit.conf",
    "zathura": HOME / ".config/zathura/colors",            # PDF viewer (included by zathurarc)   # password dialog (hyprpolkitagent) & other hypr* apps
}


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


# ---------- 1. wallpaper ----------
def gnome_wallpaper():
    uri = run("gsettings", "get", "org.gnome.desktop.background", "picture-uri").strip("'")
    p = Path(unquote(urlparse(uri).path)) if uri.startswith("file://") else None
    return p if p and p.is_file() else None


wall = gnome_wallpaper()
if wall and LINK.resolve() != wall.resolve():
    LINK.parent.mkdir(parents=True, exist_ok=True)
    tmp = LINK.with_suffix(".tmp")
    tmp.unlink(missing_ok=True)
    tmp.symlink_to(wall)
    tmp.replace(LINK)
    if run("pgrep", "-x", "hyprpaper"):         # running session: show the new wallpaper
        subprocess.run(["systemctl", "--user", "restart", "hyprpaper.service"])
src = LINK.resolve()
if not src.is_file():
    sys.exit("theme: no wallpaper found")

key = hashlib.sha1(f"{src}:{src.stat().st_mtime_ns}:v4".encode()).hexdigest()
if "--force" not in sys.argv and "--show" not in sys.argv and ALACRITTY.exists() and TMUX.exists() \
        and all(p.exists() for p in OUT.values()) and CACHE.exists() and CACHE.read_text() == key:
    sys.exit(0)

# ---------- 2. palette (perceptual: OKLab / OKLCH) ----------
# Measured like Material You does: the photo is clustered into 24 colours (k-means), each scored by how
# colourful it is and how much of the photo has its hue. Everything is measured and built in OKLab, where
# equal lightness looks equally light in every hue and "colourful" means what the eye sees.
import numpy as np
from PIL import Image


def _lin(c):
    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)


def _gamma(c):
    return np.where(c <= 0.0031308, 12.92 * c, 1.055 * np.clip(c, 0, None) ** (1 / 2.4) - 0.055)


def to_oklab(rgb):                               # rgb 0..1, shape (..., 3)
    r, g, b = (_lin(rgb[..., i]) for i in range(3))
    l = np.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    m = np.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    s_ = np.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    return np.stack([0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s_,
                     1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s_,
                     0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s_], -1)


def to_rgb(lab):
    L, a, b = lab
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s_ = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return np.array([4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s_,
                     -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s_,
                     -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s_])


def oklch_hex(L, C, h):
    """OKLCH → #rrggbb; too much chroma for the screen is reduced, never the hue or lightness."""
    for _ in range(40):
        rgb = to_rgb((L, C * math.cos(2 * math.pi * h), C * math.sin(2 * math.pi * h)))
        if rgb.min() >= -1e-4 and rgb.max() <= 1 + 1e-4:
            break
        C *= 0.92
    rgb = np.clip(_gamma(np.clip(rgb, 0, 1)), 0, 1)
    return "#{:02x}{:02x}{:02x}".format(*(int(round(v * 255)) for v in rgb))


def lch_of(hexc):
    L, a, b = to_oklab(np.array([int(hexc[i:i + 2], 16) / 255 for i in (1, 3, 5)]))
    return L, math.hypot(a, b), (math.atan2(b, a) / (2 * math.pi)) % 1


img = Image.open(src).convert("RGB")
img.thumbnail((256, 256))
lab = to_oklab(np.asarray(img, dtype=np.float64) / 255).reshape(-1, 3)
chroma = np.hypot(lab[:, 1], lab[:, 2])

# k-means in OKLab (k-means++ start), the clustering Material's quantizer refines with
rng = np.random.default_rng(7)
pts = lab[rng.choice(len(lab), min(len(lab), 40000), replace=False)]
K = 24
cent = [pts[rng.integers(len(pts))]]
for _ in range(K - 1):
    d = np.min(((pts[:, None, :] - np.array(cent)[None]) ** 2).sum(-1), 1)
    cent.append(pts[rng.choice(len(pts), p=d / d.sum())] if d.sum() > 0 else pts[rng.integers(len(pts))])
cent = np.array(cent)
for _ in range(15):
    lbl = ((pts[:, None, :] - cent[None]) ** 2).sum(-1).argmin(1)
    for k in range(K):
        if (lbl == k).any():
            cent[k] = pts[lbl == k].mean(0)
share = np.bincount(lbl, minlength=K) / len(pts)
clusters = [(float(share[k]), *cent[k]) for k in range(K) if share[k] > 0]      # (share, L, a, b)

# main tint: the average colour direction of the visible (not near-black / near-white) part
mid = (lab[:, 0] > 0.18) & (lab[:, 0] < 0.97)
mid = mid if mid.any() else np.ones(len(lab), bool)
va, vb = lab[mid, 1].mean(), lab[mid, 2].mean()
H = (math.atan2(vb, va) / (2 * math.pi)) % 1 if math.hypot(va, vb) > 1e-4 else 250 / 360
colourful = float(np.mean(chroma[mid]))            # mean OKLCH chroma: ~0.01 grey photo, ~0.1+ vivid
S = min(max(colourful / 0.11 * 0.75, 0.04), 0.85)  # how colourful the desktop gets (0 … 0.85)
NEUTRAL = colourful < 0.03                         # mostly grey / beige / white: keep the desktop calm


def hue_gap(a, b):
    d = abs(a - b) % 1
    return min(d, 1 - d)


# accent: Material-style score — colourful clusters, by chroma and by how much of the photo shares their
# hue (±15°), plus standing out from the tint (an accent the same hue as the bar wouldn't be one). Too little colour anywhere → the complement.
def hue_of(a, b):
    return (math.atan2(b, a) / (2 * math.pi)) % 1


cand = []
for sh, L, a, b in clusters:
    C = math.hypot(a, b)
    if C < 0.035 or not 0.2 <= L <= 0.92 or sh < 0.0008:
        continue
    h = hue_of(a, b)
    family = sum(s2 for s2, L2, a2, b2 in clusters if math.hypot(a2, b2) >= 0.02 and hue_gap(hue_of(a2, b2), h) < 15 / 360)
    stands_out = min(hue_gap(h, H) / (40 / 360), 1) if not NEUTRAL else 1     # ≥ 40° from the tint = fully distinct
    score = 0.6 * min(C / 0.2, 1) + 0.3 * min(math.log1p(family * 1000) / math.log1p(300), 1) + 0.4 * stands_out
    cand.append((score, h, C, L))
if cand:
    _, HA, CA, LA = max(cand)
    ACCENT_FROM = "image"
else:
    HA, CA, LA, ACCENT_FROM = (H + 0.5) % 1, 0.14, 0.7, "complement"
AC = min(max(CA * 1.35, 0.07), 0.17)               # accent chroma on screen: true to the photo, but visible


def sat(v):                                        # colourful parts of the desktop, softened for grey photos
    return min(v, max(S * 1.2, 0.05)) if NEUTRAL else v


def hls(h, l, s):
    """Colours in the old HLS terms (the designed lightness / saturation), drawn in OKLCH: the lightness and
    chroma are those of the design's reference blue, the hue is the photo's — so every hue looks as light."""
    r, g, b = colorsys.hls_to_rgb(230 / 360, max(0, min(1, l)), max(0, min(1, s)))
    L, C, _ = lch_of("#{:02x}{:02x}{:02x}".format(round(r * 255), round(g * 255), round(b * 255)))
    return oklch_hex(L, C, h % 1)


def raw_hls(h, l, s):                              # fixed colours (alerts, terminal red/green/yellow…)
    r, g, b = colorsys.hls_to_rgb(h % 1, max(0, min(1, l)), max(0, min(1, s)))
    return "#{:02x}{:02x}{:02x}".format(round(r * 255), round(g * 255), round(b * 255))


def accent_at(L):                                  # the accent at a given perceived lightness
    return oklch_hex(L, AC, HA)


# the main tint as an HLS hue, for nudging the terminal's red / green / yellow (designed in HLS degrees)
H_HLS = colorsys.rgb_to_hls(*(int(oklch_hex(0.7, 0.1, H)[i:i + 2], 16) / 255 for i in (1, 3, 5)))[0]

def lean(deg, amount=0.06):
    """Move a semantic hue a little towards the wallpaper hue."""
    d = ((H_HLS * 360 - deg + 180) % 360) - 180
    return (deg + d * amount) / 360


bg       = hls(H, 0.075, S * 0.85)
fg       = hls(H, 0.88, S * 0.45)
cursor   = hls(H, 0.74, min(1, S + 0.1))
sel      = hls(H, 0.22, S * 0.8)
black    = hls(H, 0.15, S * 0.7)
bblack   = hls(H, 0.42, S * 0.45)
white    = hls(H, 0.80, S * 0.25)
bwhite   = hls(H, 0.95, S * 0.30)
sem = {"red": 355, "green": 140, "yellow": 45, "magenta": 290}
normal = {k: raw_hls(lean(v), 0.66, 0.70) for k, v in sem.items()}
bright = {k: raw_hls(lean(v), 0.76, 0.80) for k, v in sem.items()}
normal["blue"], bright["blue"] = hls(H, 0.66, sat(max(S, 0.6))), hls(H, 0.77, sat(max(S, 0.7)))
normal["cyan"], bright["cyan"] = hls(H - 25 / 360, 0.68, sat(max(S, 0.55))), hls(H - 25 / 360, 0.78, sat(max(S, 0.65)))
order = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
normal["black"], normal["white"], bright["black"], bright["white"] = black, white, bblack, bwhite

# ---------- 3. write ----------
note = f"# Generated by ~/.config/hypr/scripts/theme from {src.name} — do not edit\n"
ALACRITTY.write_text(
    note
    + f'\n[colors.primary]\nbackground = "{bg}"\nforeground = "{fg}"\n'
    + f'\n[colors.cursor]\ntext = "{bg}"\ncursor = "{cursor}"\n'
    + f'\n[colors.selection]\ntext = "CellForeground"\nbackground = "{sel}"\n'
    + "\n[colors.normal]\n" + "".join(f'{k:<7} = "{normal[k]}"\n' for k in order)
    + "\n[colors.bright]\n" + "".join(f'{k:<7} = "{bright[k]}"\n' for k in order))

muted, accent = bblack, bright["blue"]
TMUX.write_text(note + f"""
# Accent: wallpaper blue normally, yellow while the prefix is pressed, magenta in copy mode
set -g @accent "#{{?client_prefix,{bright['yellow']},#{{?pane_in_mode,{bright['magenta']},{accent}}}}}"
set -g status-style "bg=default,fg={white}"
set -g status-left "#[fg=#{{E:@accent}},bg=default]#[fg={bg},bg=#{{E:@accent}},bold]{chr(0xF489)} #S#[fg=#{{E:@accent}},bg=default,nobold] "
setw -g window-status-format " #[fg={muted}]#I #[fg={white}]#W#{{?window_zoomed_flag,#[fg={normal['cyan']}] \U000f0349,}}#{{?window_activity_flag,#[fg={normal['yellow']}] ,}} "
setw -g window-status-current-format "#[fg={sel},bg=default]#[fg={accent},bg={sel},bold]#I #[fg={bwhite},nobold]#W#{{?window_zoomed_flag,#[fg={normal['cyan']}] \U000f0349,}}#[fg={sel},bg=default]"
setw -g window-status-bell-style "fg={normal['red']}"
set -g status-right "#($HOME/.local/bin/caffeinate tmux)#[fg={white}] #{{=/-40/…:#{{s|^#{{HOME}}|~|:pane_current_path}}}}  #[fg={muted}]│  #[fg={accent}] #[fg={bwhite}]%H:%M "
set -g pane-border-style "fg={sel}"
set -g pane-active-border-style "fg={accent}"
set -g display-panes-colour "{muted}"
set -g display-panes-active-colour "{accent}"
""" + "".join(f'set -g pane-colours[{i}] "{normal[k]}"\n' for i, k in enumerate(order))
    + "".join(f'set -g pane-colours[{i + 8}] "{bright[k]}"\n' for i, k in enumerate(order)) + f"""
set -g window-style "fg={fg},dim=13"
set -g message-style "bg={bg},fg={fg},fill={bg},width=100%"
set -g message-command-style "bg={bg},fg={accent},fill={bg},width=100%"
set -g prompt-cursor-colour "{accent}"
setw -g mode-style "bg={sel},fg={bwhite}"
setw -g copy-mode-match-style "bg={normal['magenta']},fg={bg}"
setw -g copy-mode-current-match-style "bg={bright['yellow']},fg={bg},bold"
setw -g clock-mode-colour "{accent}"
set -g popup-border-style "fg={muted}"
set -g menu-border-style "fg={muted}"
set -g menu-selected-style "bg={accent},fg={bg}"
""")
# ---------- 4. desktop theme ----------
Hc = HA                                              # accent hue: borders, "on" states


def rgba(c, a):
    return f"rgba({int(c[1:3], 16)}, {int(c[3:5], 16)}, {int(c[5:7], 16)}, {a})"


D = {   # dark: the bar
    "base": hls(H, 0.06, S * 0.8), "pill": hls(H, 0.13, S * 0.75), "slate": hls(H, 0.32, S * 0.8),
    "muted": hls(H, 0.58, S * 0.5), "steel": hls(H, 0.72, sat(max(S, 0.55))), "light": hls(H, 0.84, sat(max(S, 0.6))),
    "text": hls(H, 0.92, sat(0.45)), "star": "#ffffff", "alert": raw_hls(355 / 360, 0.72, 0.85),
    "accent": accent_at(0.76),
}
L = {   # light: launcher, menus, notifications, lock-screen box
    "bg": hls(H, 0.96, sat(0.30)), "alt": hls(H, 0.89, sat(0.28)), "fg": hls(H, 0.13, sat(0.35)),
    "muted": hls(H, 0.52, sat(0.18)), "sel": hls(H, 0.40, sat(min(max(S, 0.3), 0.55))),
    "border": hls(H, 0.82, sat(0.25)), "alert": raw_hls(355 / 360, 0.38, 0.62),   # ≥ 4.5:1 on the frosted panels, also over dark windows
    "hint": hls(H, 0.26, sat(0.22)),   # secondary text on frosted glass (≈ 4.4:1 over dark windows; "muted" is too light there)
}


# ---------- readable whatever the image: push text away from its background until it's clear enough ----------
def luminance(c):
    f = lambda v: v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (f(int(c[i:i + 2], 16) / 255) for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def readable(fg, bg, minimum):
    """Same hue and colourfulness, only the perceived lightness moves (OKLCH), until the WCAG ratio is met."""
    L_, C_, h_ = lch_of(fg)
    step = 0.01 if luminance(fg) >= luminance(bg) else -0.01
    out = fg
    while contrast(out, bg) < minimum and 0 <= L_ <= 1:
        L_ += step
        out = oklch_hex(min(max(L_, 0), 1), C_, h_)
    return out


for name, need in (("text", 7), ("light", 7), ("steel", 4.5), ("muted", 4.5), ("accent", 4.5), ("alert", 4.5)):
    D[name] = readable(D[name], D["pill"], need)          # on the bar's pills
for name, need in (("fg", 7), ("hint", 4.5), ("sel", 4.5), ("alert", 4.5)):
    L[name] = readable(L[name], L["alt"], need)            # on the light menus, panels and notifications

if "--show" in sys.argv:                                 # swatches in the terminal, nothing written
    def swatch(name, c):
        r, g, b = (int(c[i:i + 2], 16) for i in (1, 3, 5))
        return f"\033[48;2;{r};{g};{b}m      \033[0m {name:<8}{c}"
    print(f"{src.name}\n  main tint {round(H * 360)}°, colourfulness {S:.2f}{' (neutral image)' if NEUTRAL else ''}"
          f" · accent {round(HA * 360)}° from the {ACCENT_FROM}")
    print("  bar:   " + "   ".join(swatch(k, D[k]) for k in ("pill", "text", "light", "steel", "muted", "accent")))
    print("  menus: " + "   ".join(swatch(k, L[k]) for k in ("bg", "alt", "fg", "hint", "sel", "border")))
    print("  borders: " + swatch("active", accent_at(0.76)) + "   terminal: " + swatch("bg", bg) + " " + swatch("fg", fg))
    sys.exit(0)

B1, B2, BIN = accent_at(0.76), oklch_hex(0.62, AC, HA - 7 / 360), hls(H, 0.15, S * 0.8)
css_note = note.replace("# ", "/* ", 1).rstrip("\n") + " */\n"

OUT["waybar"].write_text(css_note + "".join(
    f"@define-color {k:<7} {rgba(v, 0.78) if k == 'base' else rgba(v, 0.85) if k == 'pill' else v};\n"
    for k, v in D.items()) + f"@define-color tooltip {D['base']};\n")

OUT["hypr"].write_text(note.replace("#", "--", 1) + "return {\n"
    f'    active   = {{ "rgba({B1[1:]}ff)", "rgba({B2[1:]}ff)" }},\n'
    f'    inactive = "rgba({BIN[1:]}88)",\n'
    "}\n")

OUT["rofi"].write_text(css_note + "* {\n" + "".join(f"    {k}: {v};\n" for k, v in {
    "background": L["alt"] + "b3", "background-alt": L["bg"] + "f0",   # frosted like the Notification Center: tint 70 %, cards 94 %
    "foreground": L["fg"],
    "selected": L["sel"], "active": L["border"], "urgent": L["alert"], "glow": L["border"],
    "muted": L["hint"], "on-selected": "#ffffff"}.items()) + "}\n")

def rgb(c):
    return f"{int(c[1:3], 16)}, {int(c[3:5], 16)}, {int(c[5:7], 16)}"


SN = {  # swaync variables: light frosted cards like the menus
    "cc-bg": rgba(L["alt"], 0.70), "noti-border-color": L["border"],
    "noti-bg-darker": L["alt"], "noti-bg-hover": hls(H, 0.92, 0.30), "noti-bg-focus": rgba(L["sel"], 0.10),
    "noti-close-bg": rgba(L["fg"], 0.08), "noti-close-bg-hover": rgba(L["fg"], 0.16),
    "text-color": L["fg"], "text-color-disabled": L["hint"], "bg-selected": L["sel"], "alert": L["alert"],
}
OUT["swaync"].parent.mkdir(parents=True, exist_ok=True)
OUT["swaync"].write_text(css_note + ":root {\n"
    + f"  --noti-bg: {rgb(L['bg'])};\n  --noti-bg-alpha: 0.94;\n"
    + "".join(f"  --{k}: {v};\n" for k, v in SN.items()) + "}\n"
    + "".join(f"@define-color {k} {v};\n" for k, v in SN.items())
    + f"@define-color noti-bg {rgba(L['bg'], 0.94)};\n")

OUT["lock"].write_text(note + "".join(f"${k} = rgba({v[1:]}{a})\n" for k, v, a in [
    ("lock_clock", "#ffffff", "ff"), ("lock_date", D["light"], "ff"), ("lock_user", D["light"], "ff"),
    ("lock_box", L["bg"], "e6"), ("lock_box_text", L["fg"], "ff"),
    ("lock_ring1", "#ffffff", "ee"), ("lock_ring2", L["border"], "ee"),
    ("lock_ok1", L["sel"], "ee"), ("lock_ok2", D["steel"], "ee"),
    ("lock_fail1", L["alert"], "ee"), ("lock_fail2", raw_hls(355 / 360, 0.38, 0.5), "ee")]))

def argb(c, a="ff"):
    return f"0x{a}{c[1:]}"


OUT["toolkit"].write_text(note + f"""
# Light, tinted like the launcher / notifications
background = {argb(L['bg'])}
base = {argb(L['bg'])}
alternate_base = {argb(L['alt'])}
text = {argb(L['fg'])}
bright_text = {argb('#ffffff')}
accent = {argb(L['sel'])}
accent_secondary = {argb(D['slate'])}
link_text = {argb(L['sel'])}
font_family = Fira Sans
font_family_monospace = PaperMono Nerd Font Mono
rounding_large = 19
rounding_small = 10
icon_theme = Papirus
""")

OUT["zathura"].write_text(note + f"""
# Light, tinted like the launcher / notifications
set default-bg              "{L['bg']}"
set default-fg              "{L['fg']}"
set statusbar-bg            "{L['alt']}"
set statusbar-fg            "{L['fg']}"
set inputbar-bg             "{L['bg']}"
set inputbar-fg             "{L['fg']}"
set notification-bg         "{L['bg']}"
set notification-fg         "{L['fg']}"
set notification-error-bg   "{L['alert']}"
set notification-error-fg   "#ffffff"
set notification-warning-bg "{L['alt']}"
set notification-warning-fg "{L['alert']}"
set completion-bg           "{L['alt']}"
set completion-fg           "{L['fg']}"
set completion-highlight-bg "{L['sel']}"
set completion-highlight-fg "#ffffff"
set index-bg                "{L['bg']}"
set index-fg                "{L['fg']}"
set index-active-bg         "{L['sel']}"
set index-active-fg         "#ffffff"
set highlight-color         "{rgba(L['sel'], 0.25)}"
set highlight-active-color  "{rgba(L['sel'], 0.50)}"
# Ctrl+R dark reading mode: the bar's dark colours
set recolor-lightcolor      "{D['base']}"
set recolor-darkcolor       "{D['text']}"
""")

CACHE.parent.mkdir(parents=True, exist_ok=True)
CACHE.write_text(key)

# ---------- 5. reload what is running ----------
if run("pgrep", "-x", "waybar"):
    subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"])
if run("pgrep", "-x", "swaync"):
    run("swaync-client", "--reload-css", "--skip-wait")
run("systemctl", "--user", "try-restart", "hyprpolkitagent.service")   # password dialog picks up colours
if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or run("pgrep", "-x", "Hyprland"):
    run("hyprctl", "reload")                    # borders (colors.lua is read by hyprland.lua)

# reload a running tmux that belongs to Hyprland
if run("tmux", "show-environment", "-g", "XDG_CURRENT_DESKTOP") == "XDG_CURRENT_DESKTOP=Hyprland":
    run("tmux", "source-file", str(HOME / ".config/tmux/tmux.conf"))
print(f"theme from {src.name}: hue {round(H * 360)}°, accent (borders) {B1}, bar {D['pill']}, menus {L['bg']}")
