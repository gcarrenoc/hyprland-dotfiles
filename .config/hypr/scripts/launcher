#!/usr/bin/env python3
"""App launcher with "jump to it if it's already open" (macOS-style).

  Enter        → if the app has a window, go to it (switching workspace);
                 otherwise open it.
  Shift+Enter  → always open a new window here.

Apps are listed most-used first. Used by Super+D and the Arch button in Waybar.
"""
import configparser, json, os, subprocess, sys
from pathlib import Path

HOME = Path.home()
HISTORY = HOME / ".cache" / "hypr-launcher-history.json"
DESKTOP = os.environ.get("XDG_CURRENT_DESKTOP", "Hyprland").split(":")
APP_DIRS = [
    HOME / ".local/share/applications",
    HOME / ".local/share/flatpak/exports/share/applications",
    Path("/var/lib/flatpak/exports/share/applications"),
    Path("/usr/local/share/applications"),
    Path("/usr/share/applications"),
]


def load_apps():
    apps, seen = [], set()
    for d in APP_DIRS:
        if not d.is_dir():
            continue
        for f in sorted(d.rglob("*.desktop")):
            app_id = str(f.relative_to(d)).replace("/", "-")
            if app_id in seen:          # first directory wins (user overrides)
                continue
            seen.add(app_id)
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            cp.optionxform = str
            try:
                cp.read(f, encoding="utf-8")
                e = cp["Desktop Entry"]
            except Exception:
                continue
            if e.get("Type") != "Application" or e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
                continue
            only = [x for x in e.get("OnlyShowIn", "").split(";") if x]
            nots = [x for x in e.get("NotShowIn", "").split(";") if x]
            if (only and not set(only) & set(DESKTOP)) or set(nots) & set(DESKTOP):
                continue
            name = e.get("Name")
            if not name:
                continue
            exe = os.path.basename(e.get("Exec", "").split()[0]) if e.get("Exec") else ""
            stem = app_id.removesuffix(".desktop")
            keys = {stem, e.get("StartupWMClass", ""), exe.removesuffix(".AppImage")}
            if exe == "flatpak":        # flatpak run … <app-id>: match the id and its last part
                keys.discard("flatpak")
                keys.add(stem.rsplit(".", 1)[-1])
            apps.append({
                "id": app_id,
                "name": name,
                "icon": e.get("Icon", ""),
                "keys": {k.lower() for k in keys if k},
            })
    return apps


def history():
    try:
        return json.loads(HISTORY.read_text())
    except Exception:
        return {}


def remember(app_id):
    h = history()
    h[app_id] = h.get(app_id, 0) + 1
    HISTORY.parent.mkdir(parents=True, exist_ok=True)
    HISTORY.write_text(json.dumps(h))


def find_window(app):
    """Most recently used window that belongs to this app, or None."""
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"],
                                            capture_output=True, text=True).stdout)
    except Exception:
        return None
    mine = [c for c in clients
            if c.get("mapped", True)
            and ({c.get("class", "").lower(), c.get("initialClass", "").lower()} & app["keys"])]
    mine.sort(key=lambda c: c.get("focusHistoryID", 999))
    return mine[0] if mine else None


TERMINAL = ["alacritty", "--config-file", str(HOME / ".config/alacritty/balcony.toml")]  # frosted terminal


def launch(app):
    cmd = TERMINAL if app["id"] == "Alacritty.desktop" else [app["id"]]
    subprocess.Popen(["uwsm", "app", "--", *cmd], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


LOG = HOME / ".cache" / "hypr-launcher.log"


def log(msg):
    try:
        lines = LOG.read_text().splitlines()[-200:] if LOG.exists() else []
        lines.append(f"{__import__('time').strftime('%H:%M:%S')}  {msg}")
        LOG.write_text("\n".join(lines) + "\n")
    except Exception:
        pass


def main():
    apps = load_apps()
    h = history()
    apps.sort(key=lambda a: (-h.get(a["id"], 0), a["name"].lower()))
    # make every label unique so the chosen text maps back to exactly one app
    by_label, rows = {}, []
    for a in apps:
        label = a["name"]
        if label in by_label:
            label = f"{a['name']} ({a['id'].removesuffix('.desktop')})"
        by_label[label] = a
        rows.append(f"{label}\0icon\x1f{a['icon']}")
    r = subprocess.run(
        ["env", "-u", "WAYLAND_DISPLAY", "rofi", "-dmenu", "-i", "-show-icons", "-no-custom", "-format", "s",
         "-p", "\U000f0349", "-mesg", "↵ go to app    ⇧↵ new window",
         "-theme-str", "textbox { text-color: #7b8d96; horizontal-align: 0.5; }",
         "-kb-accept-custom", "", "-kb-accept-alt", "", "-kb-custom-1", "Shift+Return"],
        input="\n".join(rows), capture_output=True, text=True)
    choice = r.stdout.rstrip("\n")
    if r.returncode not in (0, 10) or choice not in by_label:
        log(f"cancelled (exit {r.returncode}, {choice!r}) {r.stderr.strip()[:200]}")
        return
    app = by_label[choice]
    remember(app["id"])
    if r.returncode == 0:
        w = find_window(app)
        if w:
            res = subprocess.run(["hyprctl", "dispatch",
                                  f'hl.dsp.focus({{ window = "address:{w["address"]}" }})'],
                                 capture_output=True, text=True)
            log(f"{app['name']}: go to window {w['class']!r} on workspace {w['workspace']['id']} → {res.stdout.strip()}")
            return
        log(f"{app['name']}: not open (keys {sorted(app['keys'])}) → launch {app['id']}")
    else:
        log(f"{app['name']}: Shift+Enter → new window {app['id']}")
    launch(app)


if __name__ == "__main__":
    sys.exit(main())
