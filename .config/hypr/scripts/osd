#!/usr/bin/env bash
# On-screen display for volume / mic / brightness keys (swaync pop-up with a progress bar).
#   osd volume up|down|mute    osd mic mute    osd brightness up|down
# swaync shows "osd" pop-ups even in do not disturb and never keeps them in the panel
# (see ~/.config/swaync/config.json); this script closes each one 1.5 s after the last key press.
set -u
ICONS=/usr/share/icons/Papirus-Light/24x24/panel   # dark icons for the light pop-up

notify() { # $1 tag  $2 icon  $3 title  $4 value(0-100, optional)
  local hint=() id stamp file="${XDG_RUNTIME_DIR:-/tmp}/osd-$1"
  [[ -n ${4:-} ]] && hint=(-h "int:value:$4")
  id=$(notify-send -p -a osd -u low -i "$ICONS/$2.svg" \
    -h "string:x-canonical-private-synchronous:$1" "${hint[@]}" "$3")
  stamp=$EPOCHREALTIME; echo "$stamp" > "$file"
  ( sleep 1.5
    [[ $(< "$file") == "$stamp" ]] && gdbus call --session --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.CloseNotification "$id" >/dev/null 2>&1
  ) & disown
}

vol_pct() { wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2*100}'; }
is_muted() { wpctl get-volume "$1" | grep -q MUTED; }

case "${1:-} ${2:-}" in
  "volume up")   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  "volume down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  "volume mute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "mic mute")
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    if is_muted @DEFAULT_AUDIO_SOURCE@; then notify mic microphone-sensitivity-muted "Microphone muted"
    else notify mic microphone-sensitivity-high "Microphone on"; fi
    exit 0 ;;
  "brightness up")   brightnessctl -q -e2 -n50 set 5%+ ;;
  "brightness down") brightnessctl -q -e2 -n50 set 5%- ;;
  *) echo "usage: osd volume up|down|mute | mic mute | brightness up|down" >&2; exit 2 ;;
esac

case $1 in
  volume)
    v=$(vol_pct)
    if is_muted @DEFAULT_AUDIO_SINK@; then notify volume audio-volume-muted "Muted" 0
    elif (( v < 34 )); then notify volume audio-volume-low "Volume  $v%" "$v"
    elif (( v < 67 )); then notify volume audio-volume-medium "Volume  $v%" "$v"
    else notify volume audio-volume-high "Volume  $v%" "$v"; fi ;;
  brightness)
    b=$(awk -v r="$(brightnessctl get)" -v m="$(brightnessctl max)" 'BEGIN { printf "%d", sqrt(r / m) * 100 + 0.5 }')   # perceived, as in the brightness panel
    notify brightness gpm-brightness-lcd "Brightness  $b%" "$b" ;;
esac
