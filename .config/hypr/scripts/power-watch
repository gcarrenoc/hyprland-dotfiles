#!/usr/bin/env bash
# Power watcher (runs every minute via ~/.config/systemd/user/power-watch.timer)
#   • battery 20%  → power saver plan (the previous plan comes back when you plug in)
#   • battery 15%  → low-battery notification
#   • battery 8%   → urgent notification      (both also show in do not disturb)
#   • battery 5%   → hibernate once that has been tested (scripts/hibernate --tested), else suspend
#   • on battery   → lighter blur (1 pass) to save power; plugged in → 3 passes
# Warnings fire once per discharge and reset when you plug in.
set -u
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1) AC=$(ls -d /sys/class/power_supply/{AC,ADP}*/online 2>/dev/null | head -1)
[[ -n $BAT ]] || exit 0                        # no battery (desktop PC)
STATE="$HOME/.cache/power-watch"
SAVER_STATE="$HOME/.cache/power-watch-saver"   # exists while we switched to power saver; holds the previous plan
SAVER=20 LOW=15 CRIT=8 SUSPEND=5 BLUR_AC=3 BLUR_BAT=1

cap=$(<"$BAT/capacity") status=$(<"$BAT/status") ac=$(<"$AC")
warned=0
[[ -f $STATE ]] && read -r warned < "$STATE"

notify() { notify-send -a Battery "$@"; }

if [[ $status == Discharging ]]; then
  if (( cap <= SUSPEND )); then
    how=suspend what="Suspending"
    if "$HOME/.config/hypr/scripts/hibernate" --auto; then how=hibernate what="Hibernating"; fi
    notify -u critical -i battery-empty "Battery at ${cap}%" "$what now — plug in the charger."
    sleep 5; systemctl "$how" || systemctl suspend
  elif (( cap <= CRIT && warned < 2 )); then
    notify -u critical -i battery-caution "Battery at ${cap}% — plug in now" "The laptop will suspend at ${SUSPEND}%."
    warned=2
  elif (( cap <= LOW && warned < 1 )); then
    notify -u critical -i battery-low "Battery low: ${cap}%" "About time to plug in the charger."
    warned=1
  fi
else
  warned=0                                   # charging / full → reset
fi
mkdir -p "${STATE%/*}"; echo "$warned" > "$STATE"

# power saver at 20 %: switch once per discharge (if you change the plan afterwards, it stays yours);
# on the charger, put the previous plan back — unless you already changed it yourself
if command -v powerprofilesctl >/dev/null; then
  plan=$(powerprofilesctl get 2>/dev/null)
  if [[ $status == Discharging ]]; then
    if (( cap <= SAVER )) && [[ ! -f $SAVER_STATE && -n $plan ]]; then
      echo "$plan" > "$SAVER_STATE"
      if [[ $plan != power-saver ]] && powerprofilesctl set power-saver; then
        notify -u low -i battery-low "Power saver on" "Battery at ${cap}% — your ${plan} plan comes back when you plug in."
      fi
    fi
  elif [[ -f $SAVER_STATE ]]; then
    read -r before < "$SAVER_STATE"
    [[ $plan == power-saver && -n $before && $before != power-saver ]] && powerprofilesctl set "$before"
    rm -f "$SAVER_STATE"
  fi
fi

# blur: lighter on battery (only touch Hyprland when the value has to change)
want=$BLUR_AC; [[ $ac == 0 ]] && want=$BLUR_BAT
have=$(hyprctl getoption decoration:blur:passes 2>/dev/null | awk '/int:/{print $2}')
if [[ -n $have && $have != "$want" ]]; then
  hyprctl dispatch "function() hl.config({ decoration = { blur = { passes = $want } } }) end" >/dev/null
fi
