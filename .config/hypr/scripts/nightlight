#!/usr/bin/env bash
# Night light (hyprsunset).
#   nightlight toggle     on/off              (Waybar click)
#   nightlight up|down    cooler / warmer      (Waybar scroll, only while on)
#   nightlight auto       follow the sun: on at sunset, off at sunrise
#                         (only acts when day/night changes, so a manual toggle is respected)
#   nightlight waybar     JSON status for the bar
# State (on/off + chosen warmth) is kept in ~/.cache/nightlight.
set -u
STATE="$HOME/.cache/nightlight"
DEFAULT=4000 MIN=2500 MAX=6000 STEP=250

on=0 temp=$DEFAULT period=""
[[ -f $STATE ]] && read -r on temp period < "$STATE"
save() { mkdir -p "${STATE%/*}"; echo "$on $temp $period" > "$STATE"; pkill -RTMIN+9 -x waybar 2>/dev/null || true; }
SUN="$(dirname "$(readlink -f "$0")")/suntimes"
ensure() { pgrep -x hyprsunset >/dev/null || { setsid -f uwsm app -- hyprsunset -i >/dev/null 2>&1; sleep 0.8; }; }
apply() { ensure; if (( on )); then hyprctl hyprsunset temperature "$temp" >/dev/null; else hyprctl hyprsunset identity >/dev/null; fi; }

case ${1:-} in
  toggle) on=$(( 1 - on )); apply; save ;;
  up)     (( on )) || exit 0; temp=$(( temp + STEP > MAX ? MAX : temp + STEP )); apply; save ;;
  down)   (( on )) || exit 0; temp=$(( temp - STEP < MIN ? MIN : temp - STEP )); apply; save ;;
  restore) apply ;;                        # at login: reapply last state
  auto)
    read -r now rise sset < <("$SUN")
    if [[ $now != "$period" ]]; then         # day ↔ night changed (or first run)
      period=$now
      [[ $now == night ]] && on=1 || on=0
      apply; save
    fi ;;
  waybar)
    if (( on )); then
      read -r _ rise sset < <("$SUN")
      printf '{"text":"\uf4ee","class":"on","tooltip":"Night light on · %sK\\nAuto: on at sunset %s, off at sunrise %s\\nClick: off · Scroll: warmer / cooler"}\n' "$temp" "$sset" "$rise"
    else
      read -r _ rise sset < <("$SUN")
      printf '{"text":"\uf4ee","class":"off","tooltip":"Night light off\\nAuto: on at sunset %s, off at sunrise %s\\nClick: on (%sK)"}\n' "$sset" "$rise" "$temp"
    fi ;;
  *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
