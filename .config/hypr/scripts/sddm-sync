#!/usr/bin/env bash
# sddm-sync — set up the SDDM login theme so it follows the wallpaper. Runs as root (pkexec), once:
#   sddm-sync <user> <theme-source-dir>
# The theme (/usr/share/sddm/themes/hyprlock-match) stays root-owned; only its picture and colours are links
# into /var/lib/login-screen, a folder owned by <user>. From then on `wallpaper` updates the login screen
# without a password. No root process ever reads files from the user's home after this setup.
set -euo pipefail
USER_=$1 SRC=$2
DEST=/usr/share/sddm/themes/hyprlock-match
LOOK=/var/lib/login-screen
id "$USER_" >/dev/null
install -d -m755 "$DEST"
install -m644 "$SRC"/Main.qml "$SRC"/metadata.desktop "$DEST"/
install -d -m755 -o "$USER_" -g "$USER_" "$LOOK"
# keep what's there now until the first `wallpaper` run fills the folder
for f in background.jpg theme.conf; do
  if [[ -f $DEST/$f && ! -L $DEST/$f && ! -e $LOOK/$f ]]; then install -m644 -o "$USER_" -g "$USER_" "$DEST/$f" "$LOOK/$f"; fi
  ln -sfn "$LOOK/$f" "$DEST/$f"
done
echo "Login screen now follows the wallpaper (files in $LOOK)."
