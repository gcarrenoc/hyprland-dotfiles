#!/usr/bin/env bash
# screenshot full   → whole screen, saved to ~/Pictures/Screenshots and copied (Shift+Print)
# screenshot window → the active window, the same (Alt+Print) · Print: the overlay (panels/screenshot.py)
# screenshot area   → select an area, then annotate/save it in swappy
set -euo pipefail
# no coloured window borders in the picture (hyprland.lua: Borders(); transparent, nothing moves)
hide() { hyprctl dispatch 'function() Borders(false) end' >/dev/null; sleep 0.05; }
show() { hyprctl dispatch 'function() Borders(true) end' >/dev/null; }
dir="$HOME/Pictures/Screenshots"; mkdir -p "$dir"
file="$dir/Screenshot From $(date "+%Y-%m-%d %H-%M-%S").png"

case ${1:-full} in
  full)
    hide; grim "$file"; show
    wl-copy < "$file"
    notify-send -a Screenshot -i "$file" "Screenshot saved" "Copied to clipboard · ${file/#$HOME/~}" ;;
  window)
    id=$(hyprctl activewindow -j | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("stableId", ""))')
    [[ -n $id ]] && grim -T "$id" "$file" || exit 0
    scale=$(hyprctl monitors -j | python3 -I -c 'import json,sys; print(next((m["scale"] for m in json.load(sys.stdin) if m["focused"]), 1.25))')
    "$(dirname "$0")/round-corners" "$file" "$scale"      # its rounded corners, as on screen
    wl-copy < "$file"
    notify-send -a Screenshot -i "$file" "Screenshot of the window saved" "Copied to clipboard · ${file/#$HOME/~}" ;;
  area)
    css=~/.config/waybar/colors.css                        # colours of the wallpaper
    colour() { sed -n "s/^@define-color $1 *#\([0-9a-fA-F]\{6\}\);.*/\1/p" "$css" 2>/dev/null; }
    line=$(colour steel); shade=$(colour tooltip)
    geom=$(slurp -b "${shade:-20212c}88" -c "${line:-a7caff}ee" -w 2) || exit 0   # Esc cancels
    hide; grim -g "$geom" "$file.tmp"; show
    swappy -f "$file.tmp" -o "$file"; rm -f "$file.tmp" ;;
esac
