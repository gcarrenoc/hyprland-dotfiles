#!/usr/bin/env bash
# screenshot full   → whole screen, saved to ~/Pictures/Screenshots and copied
# screenshot area   → select an area, then annotate/save it in swappy
set -euo pipefail
dir="$HOME/Pictures/Screenshots"; mkdir -p "$dir"
file="$dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

case ${1:-full} in
  full)
    grim "$file"
    wl-copy < "$file"
    notify-send -a Screenshot -i "$file" "Screenshot saved" "Copied to clipboard · ${file/#$HOME/~}" ;;
  area)
    css=~/.config/waybar/colors.css                        # colours of the wallpaper
    colour() { sed -n "s/^@define-color $1 *#\([0-9a-fA-F]\{6\}\);.*/\1/p" "$css" 2>/dev/null; }
    line=$(colour steel); shade=$(colour tooltip)
    geom=$(slurp -b "${shade:-20212c}88" -c "${line:-a7caff}ee" -w 2) || exit 0   # Esc cancels
    grim -g "$geom" - | swappy -f - -o "$file" ;;
esac
