#!/usr/bin/env bash
# Power menu (rofi). Used by Super+Shift+E and the power button in Waybar.
row() { ~/.config/hypr/scripts/menu --icon "$1" "$2"; }
lock=$(row f023 Lock); suspend=$(row f186 Suspend); logout=$(row f2f5 "Log out"); reboot=$(row f2f1 Restart); shutdown=$(row f011 "Shut down")

options=("$lock" "$suspend")
hibernate=$(row f2dc Hibernate); ~/.config/hypr/scripts/hibernate --can && options+=("$hibernate")
options+=("$logout" "$reboot" "$shutdown")
choice=$(printf '%s\n' "${options[@]}" |
  ~/.config/hypr/scripts/menu -dmenu -i -markup-rows -p "" -theme ~/.config/rofi/powermenu.rasi \
       -mesg "$(row f017 "$(uptime -p | sed 's/^up //')")") || exit 0

confirm() {
  [[ $(printf 'Yes\nNo\n' | ~/.config/hypr/scripts/menu -dmenu -p "" -theme ~/.config/rofi/powermenu.rasi -mesg "$1?") == Yes ]]
}

case $choice in
  "$lock")     loginctl lock-session ;;
  "$suspend")  systemctl suspend ;;
  "$hibernate") ~/.config/hypr/scripts/hibernate ;;
  "$logout")   confirm "Log out" && uwsm stop ;;
  "$reboot")   confirm "Restart" && systemctl reboot ;;
  "$shutdown") confirm "Shut down" && systemctl poweroff ;;
esac
