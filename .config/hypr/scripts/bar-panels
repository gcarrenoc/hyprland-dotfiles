#!/usr/bin/env python3
"""bar-panels — the panels that drop down from the bar: wifi, bluetooth, sound, brightness, battery, and the screenshot overlay (macOS-style, frosted).

Fast like Spotlight: stays loaded, hidden (started at login) and the bar only shows a panel:
    scripts/panel wifi | bluetooth | sound | brightness | battery | screenshot
           (→ D-Bus; also starts this program if it isn't running)
Click the icon again, click outside or press Esc to close. The panels: scripts/panels/*.py
Colours come from ~/.config/rofi/colors.rasi (generated from the wallpaper by scripts/theme).
Also the drag edges (panels/drag_edges.py): actions drag-start / drag-end, sent by Hyprland on every
left-button press / release, show invisible strips at the screen edges for dragging files to another workspace.
"""
import importlib, subprocess, sys, traceback
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "panels"))
sys.dont_write_bytecode = True
from base import Gdk, Gtk, theme_css                      # first: loads layer-shell before GTK
from gi.repository import Gio, GLib

# name → (module, class). Each is loaded on its own: one that fails (a service not ready at
# login, a bug) leaves the others working and is tried again the next time it's opened.
PANELS = {"sound": ("sound", "SoundPanel"), "wifi": ("wifi", "WifiPanel"), "battery": ("battery", "BatteryPanel"),
          "bluetooth": ("bluetooth", "BluetoothPanel"), "brightness": ("brightness", "BrightnessPanel"),
          "screenshot": ("screenshot", "ScreenshotOverlay")}


class App(Gtk.Application):
    def __init__(self, first=None):
        super().__init__(application_id="local.BarPanels", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.first, self.panels = first, {}

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()                                       # stay loaded with no window shown
        self.css = Gtk.CssProvider()
        self.css.load_from_string(theme_css())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        for name in PANELS:
            self.load(name)
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, n=name: self.toggle(n))
            self.add_action(action)
        self.edges = None
        try:
            from drag_edges import DragEdges
            self.edges = DragEdges(self)
        except Exception:
            traceback.print_exc()
        for name, method in (("drag-start", "show"), ("drag-end", "hide")):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, m=method: self.edges and getattr(self.edges, m)())
            self.add_action(action)

    def load(self, name):
        try:
            module, cls = PANELS[name]
            self.panels[name] = getattr(importlib.import_module(module), cls)(self)
        except Exception:
            traceback.print_exc()                         # in the log: journalctl --user -u bar-panels
        return self.panels.get(name)

    def do_activate(self):
        if self.first:
            name, self.first = self.first, None
            self.toggle(name)

    def toggle(self, name):
        for n, p in self.panels.items():
            if n != name and p.get_visible():
                p.dismiss()
        self.css.load_from_string(theme_css())            # follow wallpaper changes
        panel = self.panels.get(name) or self.load(name)
        if panel:
            panel.toggle()
        else:
            subprocess.Popen(["notify-send", "-a", "Panels", f"The {name} panel couldn't start",
                              "journalctl --user -u bar-panels"])


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    sys.exit(App(first=arg if arg in PANELS else None).run(None))
