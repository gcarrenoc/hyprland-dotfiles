#!/usr/bin/env bash
# Do not disturb (dunst pause). Notifications are held while on and shown when you turn it off.
#   dnd toggle   on/off (Waybar click)
#   dnd waybar   JSON status for the bar
set -u
refresh() { pkill -RTMIN+10 -x waybar 2>/dev/null || true; }
case ${1:-} in
  toggle)
    if [[ $(dunstctl is-paused) == true ]]; then
      dunstctl set-paused false
      notify-send -a "Do not disturb" -u low -i notifications "Do not disturb off" "Notifications are back."
    else
      notify-send -a "Do not disturb" -u low -i notifications-disabled "Do not disturb on" "Notifications will wait until you turn it off."
      sleep 1.5; dunstctl set-paused true
    fi
    refresh ;;
  waybar)
    if [[ $(dunstctl is-paused) == true ]]; then
      n=$(dunstctl count waiting)
      label=$'\U000f009b'; (( n > 0 )) && label+=" $n"
      printf '{"text":"%s","class":"on","tooltip":"Do not disturb: on · %s waiting\\nClick: turn off (shows them)"}\n' "$label" "$n"
    else
      printf '{"text":"\U000f009a","class":"off","tooltip":"Do not disturb: off\\nClick: turn on"}\n'
    fi ;;
  *) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
