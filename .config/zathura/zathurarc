# Zathura — PDF viewer

# Colours follow the wallpaper (generated by ~/.config/hypr/scripts/theme)
include colors

# Behaviour
set selection-clipboard primary     # selecting text does NOT touch the clipboard (middle-click pastes it)
set adjust-open best-fit            # open fitted to the window
set window-title-basename true      # just the file name in the title…
set statusbar-basename true         # …and in the status bar
set font "PaperMono Nerd Font 10"
set statusbar-h-padding 10
set statusbar-v-padding 4
set scroll-step 80
set recolor-keephue true            # Ctrl+R: dark reading mode keeps image colours

# Arrow keys: ← → previous / next page, ↑ ↓ scroll (normal and fullscreen view)
map <Left>  navigate previous
map <Right> navigate next
map <Up>    scroll up
map <Down>  scroll down
map [fullscreen] <Left>  navigate previous
map [fullscreen] <Right> navigate next
map [fullscreen] <Up>    scroll up
map [fullscreen] <Down>  scroll down

# Ctrl+C: copy the current selection to the clipboard (then Ctrl+V anywhere)
map <C-c> feedkeys ":exec sh -c 'wl-paste --primary --no-newline | wl-copy && notify-send -a Zathura -u low Copied'<Return>"
