# Zathura — PDF viewer (light steel theme, matches the launcher/notifications)
set selection-clipboard clipboard   # selecting text copies it (Ctrl+V to paste)
set font "PaperMono Nerd Font 10"
set adjust-open best-fit
set window-title-basename true
set statusbar-basename true
set statusbar-h-padding 10
set statusbar-v-padding 4
set page-padding 4
set scroll-step 80
set smooth-scroll true

set default-bg              "#f2f5f7"
set default-fg              "#1c2228"
set statusbar-bg            "#e1e7eb"
set statusbar-fg            "#1c2228"
set inputbar-bg             "#f2f5f7"
set inputbar-fg             "#1c2228"
set notification-bg         "#f2f5f7"
set notification-fg         "#1c2228"
set notification-error-bg   "#b24a4a"
set notification-error-fg   "#ffffff"
set notification-warning-bg "#e1e7eb"
set notification-warning-fg "#b24a4a"
set completion-bg           "#e1e7eb"
set completion-fg           "#1c2228"
set completion-highlight-bg "#4f6672"
set completion-highlight-fg "#ffffff"
set index-bg                "#f2f5f7"
set index-fg                "#1c2228"
set index-active-bg         "#4f6672"
set index-active-fg         "#ffffff"
set highlight-color         "rgba(1, 102, 212, 0.25)"
set highlight-active-color  "rgba(1, 102, 212, 0.50)"

# Ctrl+R = dark reading mode (recolour pages)
set recolor-lightcolor "#051221"
set recolor-darkcolor  "#d5e0ec"
set recolor-keephue true
