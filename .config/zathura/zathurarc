# Zathura — PDF viewer

# Colours follow the wallpaper (generated by ~/.config/hypr/scripts/theme)
include colors

# Behaviour
set selection-clipboard primary     # store selection in primary so Ctrl+C can copy it
set selection-notification false    # hide "Copied selected text..." message
set adjust-open width               # open fitted to page width
set window-title-basename true      # just the file name in the title…
set statusbar-basename true         # …and in the status bar
set font "PaperMono Nerd Font 10"
set statusbar-h-padding 10
set statusbar-v-padding 4
set scroll-step 80
set recolor-keephue true            # Ctrl+R: dark reading mode keeps image colours

# Ctrl+C: silently copy the current selection to the clipboard
map <C-c> feedkeys ":exec sh -c 'wl-paste --primary --no-newline | wl-copy'<Return>"
map [fullscreen] <C-c> feedkeys ":exec sh -c 'wl-paste --primary --no-newline | wl-copy'<Return>"
