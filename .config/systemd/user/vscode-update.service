[Unit]
Description=Update VS Code in the home folder (verified, no password; used from its next start)
After=graphical-session.target
# no connection yet? try again every 20 min, at most 12 times
StartLimitIntervalSec=6h
StartLimitBurst=12

[Service]
Type=oneshot
ExecStart=%h/.local/bin/vscode-update
TimeoutStartSec=15min
Restart=on-failure
RestartSec=20min
# 1 = something is wrong (it notified): trying again soon won't help
RestartPreventExitStatus=1
