# Dunst — Balcony (colours from github.com/1amSimp1e/dots, balcony branch)
# Only runs in Hyprland; GNOME uses its own notifications.

[global]
    font = "PaperMono Nerd Font 10"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    word_wrap = yes
    ignore_newline = no
    show_age_threshold = 60
    sort = yes
    indicate_hidden = yes

    width = 340
    height = (0, 300)
    origin = top-right
    offset = (16, 16)
    notification_limit = 6
    gap_size = 8

    padding = 14
    horizontal_padding = 14
    text_icon_padding = 14
    frame_width = 2
    corner_radius = 17
    separator_height = 2
    separator_color = frame
    transparency = 0

    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 5

    idle_threshold = 120
    sticky_history = yes
    history_length = 30
    show_indicators = no
    follow = none
    layer = overlay

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5
    background = "#f2f5f7f0"
    foreground = "#1c2228"
    frame_color = "#d5dde2"
    highlight = "#4f6672"

[urgency_normal]
    timeout = 8
    background = "#f2f5f7f0"
    foreground = "#1c2228"
    frame_color = "#8fa3b0"
    highlight = "#4f6672"

[urgency_critical]
    timeout = 0
    background = "#f2f5f7f0"
    foreground = "#1c2228"
    frame_color = "#b24a4a"
    highlight = "#b24a4a"

# Volume / brightness pop-ups (from ~/.config/hypr/scripts/osd)
[osd]
    appname = osd
    format = "<b>%s</b>"
    timeout = 1.5
    frame_color = "#d5dde2"
    history_ignore = yes

[osd-brightness]
    appname = osd
    stack_tag = brightness
    highlight = "#3a4f5b"
